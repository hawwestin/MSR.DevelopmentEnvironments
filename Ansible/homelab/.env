# Example ENV file. Create copy of this file and provide correct values for your environment.
# use linux LF line endings for this file
# Use $HOME instead of ~ for home directory in this file as ~is not expanded in .env files.
export ANSIBLE_PRIVATE_KEY_FILE="$HOME/.ssh/id_rsa_windows"
export ANSIBLE_CONFIG="$PWD/Ansible/homelab/ansible.cfg"
export ANSIBLE_VAULT_PASSWORD_FILE="$HOME/.ansible/vault-password"