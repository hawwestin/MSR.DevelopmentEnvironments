# Example file for Ansible inventory plugin configuration
export PROXMOX_URL="https://your-proxmox-server:8006"
export PROXMOX_USER="ansible@pve"
export PROXMOX_TOKEN_ID="token-ansible"
unset PROXMOX_PASSWORD
# It is highly recommended to use API tokens instead of root password
export PROXMOX_TOKEN_SECRET="YourProxmoxTokenSecret"